# AeroNet AI -- optional configuration
#
# Copy to `.env` and adjust if needed. Every value has a safe default, so the
# application runs with no configuration at all. Never commit a real `.env`
# file or put credentials in it: the app needs no API keys or secrets.

# Port the ASGI server listens on (default: 8000)
PORT=8000

# Optional: reuse a checkpoint from a previous run.
# AERONET_MODEL_PATH=artifacts/drone_bird_feature_lr.pkl
